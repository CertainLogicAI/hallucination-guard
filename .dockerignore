# Ignore everything by default
*

# Allow application files
!LICENSE
!README.md
!requirements.txt
!pyproject.toml
!Dockerfile
!*.py
!src/
!facts_db.json
!memory/
!deploy/

# Exclude development files
.git
.gitignore
.env
*.log
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.venv/
.vscode/
.idea/
*.swp
*.swo
